{
  "name": "@danilidonbeltran/webscrapper",
  "version": "4.0.0",
  "description": "A web scraper using Playwright to extract all text content from websites",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=11.10.0"
  },
  "bin": {
    "webscrapper": "src/cli.js"
  },
  "files": [
    "src",
    "config.json",
    "plugin-example.js"
  ],
  "types": "src/index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "scrape": "node src/cli.js scrape",
    "list-presets": "node src/cli.js list-presets",
    "show-preset": "node src/cli.js show-preset",
    "install-browsers": "npx playwright install",
    "test": "npm run test:library && npm run test:cli",
    "test:library": "node test/webscrapper.test.js",
    "test:cli": "node --test test/cli.test.js",
    "debug": "PWDEBUG=1 node src/cli.js scrape"
  },
  "keywords": [
    "webscraping",
    "playwright",
    "text-extraction"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "12.1.0",
    "playwright": "^1.40.0"
  }
}
